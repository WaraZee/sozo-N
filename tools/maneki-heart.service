[Unit]
Description=Maneki heart-rate reader
Wants=bluetooth.target
After=bluetooth.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=sozo
WorkingDirectory=/home/sozo/sozo-N/heart
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -u /home/sozo/sozo-N/heart/heart_rate.py 30
Restart=always
RestartSec=10
KillSignal=SIGINT
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
