[Unit]
Description=Maneki voice timer (USB microphone, smartphone speaker)
Wants=network-online.target
After=network-online.target sound.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=sozo
WorkingDirectory=/home/sozo/sozo-N/mic
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/bin/sh -c 'until ip -o -4 addr show wlan0 | grep -q " inet "; do sleep 2; done'
ExecStart=/usr/bin/python3 -u /home/sozo/sozo-N/mic/maneki_timer.py
Restart=always
RestartSec=10
KillSignal=SIGINT
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
